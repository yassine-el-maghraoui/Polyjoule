# Copier ce fichier en `.env` puis renseigner les valeurs. Ne jamais committer `.env`.

# Base de données PostgreSQL (ex. Neon)
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Authentification NextAuth (générer avec : openssl rand -base64 32)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Stockage des images (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Prévisualisation des brouillons (/api/preview)
PREVIEW_SECRET=""

# Google Analytics & Search Console (optionnel)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
